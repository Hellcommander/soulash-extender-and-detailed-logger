{
  "spec": 1,
  "requires": ["weapon_class", "health_percent", "inventory_count", "in_combat", "time_of_day", "equipped"],
  "conditions": [
    {
      "id": "charge_harvest_wounded",
      "target": { "kind": "passive", "id": "arendeth_runic_magic_charge_harvest" },
      "when": {
        "all": [
          { "health_percent": { "max": 50 } },
          { "weapon_class": ["Unarmed", "Natural"] }
        ]
      },
      "note": "Hoistable weapon_class is native; health_percent needs an evaluator."
    },
    {
      "id": "warding_rune_needs_charge",
      "target": { "kind": "ability", "id": "arendeth_runic_magic_Cast_Warding_Rune" },
      "when": {
        "all": [
          { "inventory_count": { "item": "arendeth_runic_magic_Rune_Charge", "min": 1 } },
          { "not": { "in_combat": false } }
        ]
      }
    },
    {
      "id": "runic_strike_by_night_or_unarmed",
      "target": { "kind": "passive", "id": "arendeth_runic_magic_runic_strike" },
      "when": {
        "any": [
          { "time_of_day": ["Night", "Late Night", "Midnight"] },
          { "equipped": { "slot": "right_hand", "empty": true } }
        ]
      },
      "on_unavailable": "inactive"
    }
  ]
}
